# Coolify variable names only. Generate every credential independently in the
# Coolify secret store; never commit populated values. URL-encode passwords in DSNs.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_DB=langtutor
LANGTUTOR_RUNTIME_PASSWORD=
LANGTUTOR_MIGRATION_PASSWORD=
DATABASE_URL=postgresql://langtutor_runtime:URL_ENCODED_PASSWORD@postgres:5432/langtutor
MIGRATION_DATABASE_URL=postgresql://langtutor_migrator:URL_ENCODED_PASSWORD@postgres:5432/langtutor
SESSION_PEPPER=
ADMIN_MFA_ENCRYPTION_KEY=
REDIS_PASSWORD=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=
APP_URL=https://langmind.sbortech.ru
ENABLE_LIVE_AI=false
OPENROUTER_API_KEY=
AI_MODEL_KEY=openrouter/gpt-4.1-mini
