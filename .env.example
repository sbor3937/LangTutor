NODE_ENV=development
HOST=127.0.0.1
PORT=3000
DATA_DIR=./data
DATABASE_PATH=./data/langtutor.sqlite
ENABLE_LIVE_AI=false
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4.1-mini
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_PROXY_URL=
GROQ_API_KEY=
GROQ_WHISPER_MODEL=whisper-large-v3-turbo
GROQ_PROXY_URL=
HTTPS_PORT=3443
TLS_KEY_PATH=
TLS_CERT_PATH=
APP_URL=http://localhost:3000
LOG_LEVEL=info
# PostgreSQL identity is enabled only when DATABASE_URL is set.
DATABASE_URL=
# Used only by the release migration job; never expose it to the web process.
MIGRATION_DATABASE_URL=
# Generate at least 32 random bytes; never commit or log the real value.
SESSION_PEPPER=
SECURE_COOKIES=false
TRUST_PROXY_HOPS=0
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=
